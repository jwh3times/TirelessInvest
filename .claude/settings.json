{
  "permissions": {
    "allow": [
      "Bash(gh project item-list *)",
      "Bash(node scripts/check-docs.mjs)",
      "Bash(node scripts/sync-agents.mjs --check)",
      "Bash(node scripts/check-skills.mjs)",
      "Bash(uv run ruff check .)",
      "Bash(node scripts/lint-agent-neutrality.mjs)",
      "Bash(uv run ruff format --check .)",
      "Bash(gh project view *)",
      "Bash(gh project field-list *)",
      "Bash(uv run pytest -q)",
      "Bash(uv run pytest)",
      "Bash(node scripts/check-changelog.mjs)",
      "Bash(node scripts/next-version.mjs)",
      "Bash(node --test \"scripts/*.test.mjs\")",
      "Bash(node scripts/check-python-version.mjs)",
      "Bash(pnpm exec supabase status)",
      "Bash(gh label list *)",
      "Bash(gh run watch *)",
      "Bash(cygpath *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__railway__get-service-config",
      "mcp__railway__list-services",
      "mcp__railway__list-projects",
      "mcp__railway__get-logs",
      "mcp__railway__fetch-docs"
    ],
    "ask": [
      "mcp__railway__accept-deploy",
      "mcp__railway__connect-service-source",
      "mcp__railway__create-bucket",
      "mcp__railway__create-deployment",
      "mcp__railway__create-function",
      "mcp__railway__create-project",
      "mcp__railway__create-service",
      "mcp__railway__create-tcp-proxy",
      "mcp__railway__create-volume",
      "mcp__railway__create-webhook",
      "mcp__railway__delete-bucket",
      "mcp__railway__delete-domain",
      "mcp__railway__delete-feature-flag",
      "mcp__railway__delete-service",
      "mcp__railway__delete-tcp-proxy",
      "mcp__railway__delete-volume",
      "mcp__railway__delete-webhook",
      "mcp__railway__deploy-template",
      "mcp__railway__generate-domain",
      "mcp__railway__get-bucket-credentials",
      "mcp__railway__list-variables",
      "mcp__railway__purge-cdn-cache",
      "mcp__railway__railway-agent",
      "mcp__railway__redeploy",
      "mcp__railway__reset-bucket-credentials",
      "mcp__railway__restart-service",
      "mcp__railway__retry-domain-certificate",
      "mcp__railway__set-beta-feature",
      "mcp__railway__set-feature-flag",
      "mcp__railway__set-service-tracing",
      "mcp__railway__set-variables",
      "mcp__railway__test-webhook",
      "mcp__railway__update-bucket",
      "mcp__railway__update-domain",
      "mcp__railway__update-function-source-code",
      "mcp__railway__update-service",
      "mcp__railway__update-volume",
      "mcp__railway__update-webhook"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs",
              "--post"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
