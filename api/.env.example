# Copy to .env for local development. Never commit .env.

# Local Supabase (from `supabase start`). On Railway use the Supabase *session pooler* URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Only needed if your project uses the legacy shared JWT secret (the local CLI prints it).
# Leave empty to verify tokens with the project's public signing keys (JWKS).
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:5173

# "db" uses prices synced from Alpaca; "synthetic" needs no keys (fake data, demo only).
PRICE_SOURCE=db

# Free at https://alpaca.markets (paper account -> API keys).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip
